<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/record_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="2dp">
    <TextView android:id="@+id/record_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/record_gap" android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/record_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/record_gap2" android:layout_width="6dp" android:layout_height="1dp" />
    <TextView android:id="@+id/record_third" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="17sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
