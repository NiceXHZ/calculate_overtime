<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_recent_heading" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_secondary" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_date_preview" android:textSize="12sp" android:textColor="@color/widget_secondary" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp" android:layout_marginBottom="2dp">
        <TextView android:id="@+id/widget_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_time_preview" android:textSize="32sp" android:textColor="@color/widget_primary" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_seconds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_seconds_preview" android:textSize="17sp" android:textColor="@color/widget_secondary" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:includeFontPadding="false" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_records" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" />
    <TextView android:id="@+id/widget_punch" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:gravity="center" android:includeFontPadding="false" android:text="@string/widget_punch" android:textColor="@color/widget_button_text" android:textSize="21sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:background="@drawable/widget_button" android:contentDescription="@string/widget_punch_description" />
</LinearLayout>
